{
  "name": "glancepad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "sim": "tsx src/ui/main.ts",
    "keypad": "tsx src/ui/main.ts --device hid",
    "keypad:probe": "tsx scripts/keypad-probe.ts",
    "sim:state": "tsx src/ui/statecli.ts",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:remove": "node scripts/install-hooks.mjs --remove",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:deps": "depcruise src",
    "gate": "tsc --noEmit && vitest run && biome check . && depcruise src",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "dependency-cruiser": "^18.1.1",
    "fast-check": "^4.9.0",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "node-hid": "3.4.0",
    "ws": "^8.21.3"
  }
}
